{
  "expo": {
    "name": "Elbetitsa Event Calendar",
    "slug": "elbetitsa-event-calendar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/img/logo.png",
    "scheme": "elbetitsaeventcalendar",
    "userInterfaceStyle": "automatic",
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "en",
          "bg"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/img/logo.png",
        "backgroundImage": "./assets/img/logo.png",
        "monochromeImage": "./assets/img/logo.png"
      },
      "package": "com.elbetitsa.elbetitsaeventcalendar"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/img/logo.png"
    },
    "locales": {
      "en": "./translator/app-metadata/en.json",
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/img/logo.png",
          "imageWidth": 200,
          "objectFit": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "bg"
            ],
            "android": [
              "en",
              "bg"
            ]
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ]
  }
}